# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp backend/.env.example backend/.env
# `.env` is git-ignored. NEVER commit real keys.
# ---------------------------------------------------------------------------

# --- Ali DashScope: ASR + TTS + voice cloning (Qwen-Audio-3.1 line) ---
DASHSCOPE_API_KEY=

# --- LLM provider (OpenAI-compatible) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Pro/moonshotai/Kimi-K2.5
LLM_THINKING_ENABLED=false
LLM_TEMPERATURE=0.3

# --- Translation chunking / glossary ---
LLM_CHUNK_MAX_SEGMENTS=25
LLM_CHUNK_MAX_CHARS=4000
LLM_CHUNK_CONTEXT_SEGMENTS=3
LLM_CHUNK_MAX_RETRIES=2
GLOSSARY_AUTO_EXTRACT=true
GLOSSARY_MAX_TERMS=40

# --- ASR (async file transcription) ---
# Qwen-Audio-3.1 line (released 2026-09-18): 30 languages + 10 Chinese
# dialects, <=12h / <=2GB per file. Model Studio's own guide recommends this
# model for "who said what", and it supports `diarization_enabled`.
#   other diarization-capable options: fun-asr, fun-asr-mtl, paraformer-v2,
#   qwen-audio-3.0-asr-flash-filetrans
#   NOT supported: qwen3-asr-flash* (emotion only, no speaker separation)
ASR_MODEL=qwen-audio-3.1-asr-flash-filetrans
ASR_DIARIZATION_ENABLED=true
# Used when the configured model rejects diarization. A different family on
# purpose, so a provider-side problem with one line still degrades gracefully.
ASR_FALLBACK_MODEL=fun-asr
ASR_MAX_WAIT=600

# --- TTS ---
# qwen-audio-3.1-tts-flash supports system voices + voice cloning + voice
# design. IMPORTANT: system voice IDs are model-specific and carry a `_v3.1`
# suffix here; a CosyVoice voice id (e.g. `longanyang`) fails with
# InvalidParameter / Engine error [411].
# The per-language voice pools live in app/config.py.
TTS_MODEL=qwen-audio-3.1-tts-flash
# Multilingual voice (Mandarin + 8 dialects + 8 foreign languages), safe for
# any target language.
TTS_DEFAULT_VOICE=longanhuan_v3.1
# Overrides the fallback pool used when the target language is unknown.
# Comma-separated. Defaults to the multilingual voices.
# TTS_VOICES=longanhuan_v3.1,xunanchuan_v3.1
TTS_CONCURRENCY=4
TTS_MAX_RETRIES=2
TTS_SAMPLE_RATE=24000

# --- Vocal separation ---
# "client" = the BROWSER runs the MDX-Net ONNX model (WebGPU/WASM) and uploads
#            the stems. Default: no server CPU/RAM cost, no API cost.
# "server" = the server runs audio-separator (needs PyTorch; do NOT use on a
#            small CPU-only host).
# "off"    = never separate.
SEPARATION_MODE=client

# Model served to the browser at GET /api/models/separator/onnx.
# Must be an MDX-Net model whose graph input is [batch, 4, 3072, 256].
SEPARATOR_MODEL_FILE=UVR-MDX-NET-Inst_HQ_3.onnx
# Chunk overlap; larger = better quality, more compute (0.001 - 0.9).
SEPARATOR_OVERLAP=0.25

# --- Capability tokens (gate the model download + stem upload) ---
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank and an ephemeral secret is generated (tokens then break on
# restart and do not work across multiple workers).
SIGNING_SECRET=
TOKEN_TTL_SECONDS=1800
TOKEN_ISSUE_LIMIT=30
TOKEN_ISSUE_WINDOW=300
# Set false only for local debugging.
REQUIRE_SEPARATOR_TOKEN=true

# Server-side separation backend (only used when SEPARATION_MODE=server).
ENABLE_BGM_SEPARATION_DEFAULT=false
PRELOAD_SEPARATION=false
SEPARATION_MODEL_NAME=2_HP-UVR.pth

# --- Export (ffmpeg mux, -c:v copy) ---
EXPORT_ENABLED=true
EXPORT_BGM_GAIN=0.9
EXPORT_ORIGINAL_AUDIO_GAIN=0.12

# --- Server ---
CORS_ORIGINS=*
SERVER_URL_BASE=http://119.45.51.201
