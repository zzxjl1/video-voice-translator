# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp backend/.env.example backend/.env
# `.env` is git-ignored. NEVER commit real keys.
# ---------------------------------------------------------------------------

# --- Ali DashScope: ASR + TTS + voice cloning (Qwen-Audio-3.1 line) ---
DASHSCOPE_API_KEY=

# --- LLM provider (OpenAI-compatible) ---
# Defaults to DeepSeek's official API. Other verified-compatible options:
#   SiliconFlow      https://api.siliconflow.cn/v1   e.g. Pro/moonshotai/Kimi-K2.6
#   DashScope 兼容模式 https://dashscope.aliyuncs.com/compatible-mode/v1  e.g. qwen-plus
# Remember to change BOTH the base URL and the model name together.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.3
# Reasoning models split this cap between hidden thinking and the answer, so
# leaving it unset can truncate a long chunk mid-JSON. deepseek-flash accepts
# 8192 (verified).
LLM_MAX_TOKENS=8192
# Have the provider guarantee a JSON object in `content`. Everything downstream
# parses JSON, so this removes a class of parse failures.
LLM_JSON_MODE=true
# Optional. Reasoning models emit `reasoning_content` before the answer, which
# costs tokens and latency; translation does not need it. Verified on
# deepseek-flash: "none" removes the reasoning block entirely.
# Recommended to uncomment when using a reasoning model.
# LLM_REASONING_EFFORT=none
# Provider-specific passthrough kept for SiliconFlow/Qwen (DeepSeek ignores it).
LLM_THINKING_ENABLED=false

# --- Translation chunking / glossary ---
LLM_CHUNK_MAX_SEGMENTS=25
LLM_CHUNK_MAX_CHARS=4000
LLM_CHUNK_CONTEXT_SEGMENTS=3
LLM_CHUNK_MAX_RETRIES=2
GLOSSARY_AUTO_EXTRACT=true
GLOSSARY_MAX_TERMS=40

# --- ASR (async file transcription) ---
# Qwen-Audio-3.1 line (released 2026-09-18): 30 languages + 10 Chinese
# dialects, <=12h / <=2GB per file. Model Studio's own guide recommends this
# model for "who said what", and it supports `diarization_enabled`.
#   other diarization-capable options: fun-asr, fun-asr-mtl, paraformer-v2,
#   qwen-audio-3.0-asr-flash-filetrans
#   NOT supported: qwen3-asr-flash* (emotion only, no speaker separation)
ASR_MODEL=qwen-audio-3.1-asr-flash-filetrans
ASR_DIARIZATION_ENABLED=true
# Used when the configured model rejects diarization. A different family on
# purpose, so a provider-side problem with one line still degrades gracefully.
ASR_FALLBACK_MODEL=fun-asr
ASR_MAX_WAIT=600

# --- TTS ---
# qwen-audio-3.1-tts-flash supports system voices + voice cloning + voice
# design. IMPORTANT: system voice IDs are model-specific and carry a `_v3.1`
# suffix here; a CosyVoice voice id (e.g. `longanyang`) fails with
# InvalidParameter / Engine error [411].
# The per-language voice pools live in app/config.py.
TTS_MODEL=qwen-audio-3.1-tts-flash
# Multilingual voice (Mandarin + 8 dialects + 8 foreign languages), safe for
# any target language.
TTS_DEFAULT_VOICE=longanhuan_v3.1
# Overrides the fallback pool used when the target language is unknown.
# Comma-separated. Defaults to the multilingual voices.
# TTS_VOICES=longanhuan_v3.1,xunanchuan_v3.1
TTS_CONCURRENCY=4
TTS_MAX_RETRIES=2
TTS_SAMPLE_RATE=24000

# --- Duration fitting (dubbing) ---
# Every line is synthesized once, measured with ffprobe (free) and
# re-synthesized once at a corrected speed if it misses its time slot by more
# than this. Up to ~20% of pitch-preserved stretching on playback is inaudible,
# so correcting tighter than that just spends TTS calls for nothing.
TTS_FIT_TOLERANCE=0.20
# `speech_rate` bounds accepted by the API (verified 0.5-2.0).
TTS_RATE_MIN=0.5
TTS_RATE_MAX=2.0
# Per-line fixed cost (lead-in + trailing pause) used by the duration model.
# Measured against the real voice; see SPEECH_UNITS_PER_SECOND in config.py for
# the per-language slopes, which are the parts that carry the signal.
TTS_FIXED_OVERHEAD=0.3

# --- Vocal separation ---
# Two backends only. There is deliberately no self-hosted option: a local
# (torch) separator needs hundreds of MB of RAM and a GPU, neither of which
# this host has. Do not add one back.
#
# "client" = the BROWSER runs the MDX-Net ONNX model (WebGPU/WASM) and uploads
#            the resulting stems. No server CPU/RAM cost, no API cost. Default.
# "api"    = 302.AI's demucs endpoint separates the audio (paid, per use).
# "off"    = never separate.
#
# This is only the DEFAULT the UI starts from; the user picks per job.
SEPARATION_MODE=client

# Initial state of the "BGM Separation" control in the UI.
ENABLE_BGM_SEPARATION_DEFAULT=false

# Model served to the browser at GET /api/models/separator/onnx.
# Must be an MDX-Net model whose graph input is [batch, 4, 3072, 256].
SEPARATOR_MODEL_FILE=UVR-MDX-NET-Inst_HQ_3.onnx
# Chunk overlap; larger = better quality, more compute (0.001 - 0.9).
SEPARATOR_OVERLAP=0.25

# --- 302.AI separation backend ("api" mode) ---
# `api.302.ai` (海外) is DNS-poisoned on mainland-China networks: it resolves to
# Facebook-owned IPs and never completes a TLS handshake. `api.302ai.com` is the
# documented 国内环境2 host. A task_id is environment-scoped (the `-e2` suffix),
# so submit and poll must use the same host.
SEPARATION_API_BASE=https://api.302ai.com
# POST -> {"task_id": "..."}
SEPARATION_API_PATH=/302/vt/subtitle/extract
# GET -> {"status": "...", "result": {...}}. Note "tasks" comes before
# "subtitle" here — the reverse of the submit path.
SEPARATION_API_RESULT_PATH=/302/vt/tasks/subtitle/{task_id}
SEPARATION_API_KEY=
SEPARATION_API_TIMEOUT=600
SEPARATION_API_POLL_INTERVAL=5
# Required by the API; irrelevant while is_only_demucs=true (no transcription).
SEPARATION_API_LANGUAGE=en
# Set true to offer the "302.AI" option in the UI. Costs 0.001 PTC per minute of
# audio for separation only. While false the UI shows the backend as unavailable
# with a reason instead of offering a broken option.
SEPARATION_API_ENABLED=false

# --- Capability tokens (gate the model download + stem upload) ---
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank and an ephemeral secret is generated (tokens then break on
# restart and do not work across multiple workers).
SIGNING_SECRET=
TOKEN_TTL_SECONDS=1800
TOKEN_ISSUE_LIMIT=30
TOKEN_ISSUE_WINDOW=300
# Set false only for local debugging.
REQUIRE_SEPARATOR_TOKEN=true

# --- Export (ffmpeg mux, -c:v copy) ---
EXPORT_ENABLED=true
EXPORT_BGM_GAIN=0.9
EXPORT_ORIGINAL_AUDIO_GAIN=0.12

# --- Server ---
CORS_ORIGINS=*
SERVER_URL_BASE=http://119.45.51.201
